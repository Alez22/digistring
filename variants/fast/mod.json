{
  "id": "digistring-fast",
  "version": "0.9.0",
  "license": "MIT",
  "title": "STRING-fast",
  "category": "Synthesis",
  "author": "Alez22",
  "description": "STRING with its per-sample loop also in on-chip SRAM: while digihealth's FAST AUDIO is on, STRING runs from there for more tracks; otherwise it runs as usual. Needs digihealth. Install either STRING or STRING-fast, not both.",
  "device": "digitakt-mk1",
  "os": "1.53",
  "sources": [
    "../../digitakt.c",
    "../../karplus.c",
    "../../ui.c"
  ],
  "cflags": [
    "-DKS_FAST"
  ],
  "weak": [
    "r_on"
  ],
  "subscribe": [
    {
      "event": "ev_render_voices",
      "fn": "digistring_render",
      "order": 20
    }
  ],
  "contribute": [
    {
      "to": "core_machines",
      "order": 80,
      "data": "00000000",
      "relocs": [
        [
          0,
          "abs32",
          "sym:digistring_machine",
          0
        ]
      ]
    }
  ],
  "requires": [
    "core",
    "machine-pages",
    "digihealth"
  ],
  "resources": {
    "names": [
      "machine:8"
    ]
  },
  "conflicts": [
    "digistring"
  ],
  "ports": {
    "1.54": {
      "cflags": [
        "-DKS_FAST",
        "-DDIGISTRING_OS154"
      ]
    }
  }
}
